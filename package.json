{
  "name": "cortico-world-figure-scape",
  "version": "0.1.0-dev.4",
  "type": "module",
  "description": "把自己的角色带进 Coo。导入 Live2D、兼容形象包或 Spriter 源工程，编辑动作、装扮和触碰。在桌面、竖屏或动态壁纸继续对话。在梦境对话面板可接续原版桌宠历史。可试录语音并查看转写。小屋世界组件在引擎页按需安装，可复用已有安装。",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/as124da1231/cortico-world-figure-scape.git"
  },
  "author": {
    "name": "as124da1231",
    "url": "https://github.com/as124da1231"
  },
  "contributors": [
    {
      "name": "Pal AI Lab",
      "url": "https://github.com/Pal-AI-Lab/Coopanion"
    },
    {
      "name": "mrdxabing",
      "url": "https://github.com/mrdxabing-rgb"
    },
    {
      "name": "SoulLink Emotion contributors",
      "url": "https://github.com/nanlingyin/soullink-emotion-sdk"
    }
  ],
  "keywords": [
    "cortico-world",
    "cortico",
    "desktop-pet",
    "live2d",
    "voice",
    "external-setup",
    "experimental",
    "streaming"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web/*": "./web/*",
    "./webui/key-capture.ts": "./src/webui/key-capture.ts",
    "./host/*": "./host/*"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Figure Scape · 梦境",
    "locales": {
      "zh": {
        "displayName": "Figure Scape · 梦境",
        "description": "把自己的角色带进 Coo。导入 Live2D、兼容形象包或 Spriter 源工程，编辑动作、装扮和触碰。在桌面、竖屏或动态壁纸继续对话。在梦境对话面板可接续原版桌宠历史。可试录语音并查看转写。小屋世界组件在引擎页按需安装，可复用已有安装。"
      },
      "en": {
        "displayName": "Figure Scape",
        "description": "Bring your own character into Coo. Import Live2D models, compatible figure packs, or Spriter projects and edit motions, outfits, and touch reactions. Keep chatting across scenes and read the stock desktop pet’s history in Figure Scape’s chat panel. Test your microphone with a transcript. In Engines, install Cabin World on demand or reuse a local installation."
      }
    },
    "webUiClient": "dist/webui-Z3GD3HMO.js",
    "webUiStyle": "dist/webui-2R5QAVJV.css",
    "describe": "describe.json",
    "tags": [
      "companion",
      "voice",
      "local",
      "streaming",
      "external-setup",
      "sensitive-data",
      "experimental"
    ]
  },
  "files": [
    "src",
    "figures/coo-dungeon",
    "web",
    "!web/whale",
    "host",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CREDITS.md",
    "CHANGELOG.md",
    "docs",
    "licenses",
    "describe.json",
    "live2d-runtime",
    "!web/speech",
    "!web/speech.js",
    "!src/speech/data",
    "scripts/build-webui.mjs",
    "scripts/prepare-cabin-runtime.py",
    "scripts/check-cabin-runtime.mjs",
    "scripts/check-native-conversation.mjs",
    "tsconfig.json",
    "!src/cua",
    "!**/live2dcubismcore.min.js",
    "!live2d-runtime/pack/sdk/framework.js",
    "!live2d-runtime/pack/sdk/shaders.js",
    "!**/*.moc3",
    "!**/*.model3.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "prepack": "node scripts/check-cabin-runtime.mjs --pins",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jpeg-js": "^0.4.4",
    "koffi": "3.3.1",
    "node-forge": "1.4.3",
    "opencc-js": "^1.4.1",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4",
    "saxes": "6.0.0",
    "sherpa-onnx-node": "1.13.8",
    "webwallgl": "3.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.0",
    "@types/pngjs": "6.0.5",
    "@types/ws": "^8.5.13",
    "electron": "44.4.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "os": [
    "win32"
  ],
  "live2dEditor": {
    "script": "dist/editor-KMN2A4CU.js",
    "style": "dist/editor-7GA4C6GX.css"
  },
  "live2dWallpaper": "dist/wallpaper-YJLN6PG7.js"
}
